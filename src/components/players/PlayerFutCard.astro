---
import { Icon } from "astro-icon/components";
import Avatar from "@/components/Avatar.astro";
import { getInitials, getWinRate } from "@/lib/players/futCard";

interface Props {
  nickname: string;
  points: number;
  matchesPlayed: number;
  wins: number;
  href?: string;
  variant?: "profile" | "list";
}

const { nickname, points, matchesPlayed, wins, href, variant = "profile" } = Astro.props;

const initials = getInitials(nickname);
const winRate = getWinRate(wins, matchesPlayed);
const Tag = href ? "a" : "div";
const isList = variant === "list";
const widthClass = isList ? "w-72" : "w-60";
const hintLabel = isList ? "Ver perfil" : "Ver ficha";
---

<Tag
  class={`hover-3d mx-auto ${widthClass}`}
  data-testid="player-fut-card"
  href={href}
  aria-label={href ? `Ver perfil de ${nickname}` : undefined}
>
  <figure
    class="bg-base-100 border-base-200 group relative flex h-full flex-col items-center rounded-xl border p-4 pb-5 shadow-md"
  >
    <span
      class="badge badge-primary font-countdown absolute start-3 top-3 border-none text-sm font-black shadow-sm"
      title="Puntos"
    >
      {points}
    </span>

    <Icon
      name="material-symbols:sports-soccer"
      size={16}
      class="text-base-content/20 absolute end-3 top-3"
      aria-hidden="true"
    />

    <div class="mt-4">
      <Avatar initial={initials} size="lg" ring={true} interactive={false} />
    </div>

    <figcaption class="mt-3 max-w-full text-center">
      <p class="truncate text-lg leading-tight font-black uppercase">
        {nickname}
      </p>
      <p class="text-base-content/50 text-xs font-bold tracking-widest uppercase">
        SGSC F.C.
      </p>
    </figcaption>

    <div class="divider my-2"></div>

    <dl class="font-countdown grid w-full grid-cols-3 gap-1 text-center">
      <div>
        <dt class="text-base-content/60 text-xs font-bold uppercase">PJ</dt>
        <dd class="text-base-content text-xl font-black">{matchesPlayed}</dd>
      </div>
      <div>
        <dt class="text-success text-xs font-bold uppercase">{isList ? "Gan" : "G"}</dt>
        <dd class="text-success text-xl font-black">{wins}</dd>
      </div>
      <div>
        <dt class={`text-xs font-bold uppercase ${isList ? "text-warning" : "text-primary"}`}>
          {isList ? "Pts" : "%"}
        </dt>
        <dd class={`text-xl font-black ${isList ? "text-warning" : "text-primary"}`}>
          {isList ? points : winRate}
        </dd>
      </div>
    </dl>

    {
      href && (
        <span class="text-primary mt-3 flex items-center gap-1 text-xs font-bold tracking-widest uppercase opacity-0 transition-opacity duration-200 group-hover:opacity-70">
          {hintLabel}
          <Icon name="material-symbols:arrow-forward" size={12} aria-hidden="true" />
        </span>
      )
    }
  </figure>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
</Tag>
