---
import { Icon } from "astro-icon/components";
import Avatar from "@/components/Avatar.astro";
import { getInitials, getWinRate } from "@/lib/players/futCard";

interface Props {
  nickname: string;
  points: number;
  matchesPlayed: number;
  wins: number;
  losses?: number | null;
  attendancePct?: number | null;
  href?: string;
  variant?: "profile" | "list";
}

const {
  nickname,
  points,
  matchesPlayed,
  wins,
  losses = null,
  attendancePct = null,
  href,
  variant = "profile",
} = Astro.props;

const initials = getInitials(nickname);
const winRate = getWinRate(wins, matchesPlayed);
const Tag = href ? "a" : "div";
const isList = variant === "list";
const widthClass = isList ? "w-full" : "w-60";
const hintLabel = isList ? "Ver perfil" : "Ver ficha";
const attendance = attendancePct === null ? null : Math.round(attendancePct);
---

<Tag
  class={`hover-3d mx-auto ${widthClass}`}
  data-testid="player-fut-card"
  href={href}
  aria-label={href ? `Ver perfil de ${nickname}` : undefined}
>
  <figure
    class="bg-base-100 border-base-200 group relative flex h-full flex-col items-center rounded-xl border p-4 pb-5 shadow-md"
  >
    <span
      class="badge badge-primary font-countdown absolute start-3 top-3 flex h-auto flex-col gap-0 border-none py-1 shadow-sm"
      title="Puntos totales"
    >
      <span class="text-[9px] leading-tight font-bold tracking-widest uppercase opacity-80">
        Pts
      </span>
      <span class="text-sm leading-tight font-black">{points}</span>
    </span>

    <Icon
      name="material-symbols:sports-soccer"
      size={16}
      class="text-base-content/20 absolute end-3 top-3"
      aria-hidden="true"
    />

    <div class="mt-4">
      <Avatar initial={initials} size="lg" ring={true} interactive={false} />
    </div>

    <figcaption class="mt-3 max-w-full text-center">
      <p class="truncate text-lg leading-tight font-black uppercase">
        {nickname}
      </p>
      <p class="text-base-content/50 text-xs font-bold tracking-widest uppercase">
        SGSC F.C.
      </p>
    </figcaption>

    <div class="divider my-2"></div>

    <dl
      class={`font-countdown grid w-full gap-x-1 text-center ${isList ? "grid-cols-2 gap-y-3 min-[420px]:grid-cols-4 min-[420px]:gap-1" : "grid-cols-3 gap-1"}`}
    >
      <div>
        <dt class="text-base-content/60 text-[11px] font-bold uppercase sm:text-xs">PJ</dt>
        <dd class="text-base-content text-lg font-black sm:text-xl">{matchesPlayed}</dd>
      </div>
      <div>
        <dt class="text-success text-[11px] font-bold uppercase sm:text-xs">{isList ? "Gan" : "G"}</dt>
        <dd class="text-success text-lg font-black sm:text-xl">{wins}</dd>
      </div>
      {isList ? (
        <>
          <div>
            <dt class="text-error text-[11px] font-bold uppercase sm:text-xs">D</dt>
            <dd class="text-error text-lg font-black sm:text-xl">{losses ?? "—"}</dd>
          </div>
          <div>
            <dt class="text-info text-[11px] font-bold uppercase sm:text-xs" title="Presentismo global">
              Pres
            </dt>
            <dd class="text-info text-lg font-black sm:text-xl">
              {attendance === null ? "—" : `${attendance}%`}
            </dd>
          </div>
        </>
      ) : (
        <div>
          <dt class="text-primary text-[11px] font-bold uppercase sm:text-xs">%</dt>
          <dd class="text-primary text-lg font-black sm:text-xl">{winRate}</dd>
        </div>
      )}
    </dl>

    {
      href && (
        <span class="text-primary mt-3 flex items-center gap-1 text-xs font-bold tracking-widest uppercase opacity-0 transition-opacity duration-200 group-hover:opacity-70">
          {hintLabel}
          <Icon name="material-symbols:arrow-forward" size={12} aria-hidden="true" />
        </span>
      )
    }
  </figure>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
</Tag>
