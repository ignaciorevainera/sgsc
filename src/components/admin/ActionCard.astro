---
import { Icon } from "astro-icon/components";
import Card from "@/components/shared/Card.astro";

interface Props {
  href: string;
  icon: string;
  title: string;
  description: string;
  color?:
    | "primary"
    | "secondary"
    | "accent"
    | "info"
    | "success"
    | "warning"
    | "error";
}

const { href, icon, title, description, color = "primary" } = Astro.props;

const colorClasses = {
  primary: {
    base: "bg-primary/10 text-primary",
    hover: "group-hover:bg-primary",
  },
  secondary: {
    base: "bg-secondary/10 text-secondary",
    hover: "group-hover:bg-secondary",
  },
  accent: {
    base: "bg-accent/10 text-accent",
    hover: "group-hover:bg-accent",
  },
  info: {
    base: "bg-info/10 text-info",
    hover: "group-hover:bg-info",
  },
  success: {
    base: "bg-success/10 text-success",
    hover: "group-hover:bg-success",
  },
  warning: {
    base: "bg-warning/10 text-warning",
    hover: "group-hover:bg-warning",
  },
  error: {
    base: "bg-error/10 text-error",
    hover: "group-hover:bg-error",
  },
};
---

<Card>
  <a
    href={href}
    class="group flex max-w-full flex-row items-center gap-3 overflow-hidden p-3.5 sm:p-4 lg:gap-5 lg:p-6"
  >
    <div
      class={`flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-full p-2.5 transition-all group-hover:scale-110 group-hover:text-white sm:p-3 lg:p-4 ${colorClasses[color].base} ${colorClasses[color].hover}`}
      aria-hidden="true"
    >
      <Icon name={icon} size={24} class="lg:hidden" />
      <Icon name={icon} size={36} class="hidden lg:block" />
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="text-sm font-black sm:text-base lg:text-lg">{title}</h3>
      <p class="text-base-content/60 text-[10px] font-bold uppercase sm:text-xs lg:text-sm">
        {description}
      </p>
    </div>
  </a>
</Card>
