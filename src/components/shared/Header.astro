---
import { Icon } from "astro-icon/components";
import Avatar from "@/components/Avatar.astro";

const session = Astro.locals.session;
const isLoggedIn = !!session;

const currentPath = Astro.url.pathname;

const isLinkActive = (href: string) => {
  if (href === "/teams") {
    return (
      currentPath.startsWith("/teams") &&
      !currentPath.startsWith("/teams-builder")
    );
  }
  if (href === "/teams-builder") {
    return currentPath.startsWith("/teams-builder");
  }
  return currentPath.startsWith(href);
};

const navGroups = [
  {
    label: "Estadísticas",
    groups: [
      { href: "/ranking", label: "Clasificación" },
      { href: "/players", label: "Jugadores" },
      { href: "/fields", label: "Canchas" },
    ],
  },
  {
    label: "Herramientas",
    groups: [
      { href: "/teams", label: "Equipos" },
      { href: "/teams-builder", label: "Armador de Equipos" },
      { href: "/versus", label: "Versus" },
    ],
  },
  {
    label: "Reconocimientos",
    groups: [
      { href: "/badges", label: "Medallas" },
      { href: "/hall-of-fame", label: "Salón de la Fama" },
      { href: "/matches", label: "Partidos" },
    ],
  },
];

const isGroupActive = (group: { href: string }[]) =>
  group.some((link) => isLinkActive(link.href));
---

<header
  id="site-header"
  class="navbar bg-base-100/90 sticky top-0 z-50 rounded-b-xl shadow-none backdrop-blur transition-shadow"
  role="banner"
>
  <div class="navbar-start">
    <div class="dropdown">
      <button
        tabindex="0"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="btn btn-ghost xl:hidden"
        role="button"
      >
        <Icon
          name="material-symbols:menu-rounded"
          size={24}
          aria-hidden="true"
        />
      </button>
      <ul
        tabindex="-1"
        id="mobile-menu"
        class="menu dropdown-content bg-base-100 z-10 mt-4 w-64 rounded-xl p-2 shadow-md"
        role="menu"
      >
        {
          navGroups.map((group, idx) => (
            <>
              <li class="menu-title text-base-content/40 text-xs uppercase">{group.label}</li>
              {group.groups.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class={isLinkActive(link.href) ? "active text-primary font-bold" : ""}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
              {idx < navGroups.length - 1 && (
                <li class="p-0" aria-hidden="true"><div class="divider m-0"></div></li>
              )}
            </>
          ))
        }
      </ul>
    </div>
    <a href="/" class="btn btn-ghost text-xl font-black">SGSC</a>
  </div>

  <nav class="navbar-center hidden xl:flex" aria-label="Navegación principal">
    <ul class="menu menu-horizontal px-1" role="menubar">
      {
        navGroups.map((group) => (
          <li>
            <details>
              <summary class={isGroupActive(group.groups) ? "text-primary font-bold" : ""}>
                {group.label}
              </summary>
              <ul class="bg-base-100 rounded-xl p-2 shadow-md">
                {group.groups.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class={isLinkActive(link.href) ? "active text-primary font-bold" : ""}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="navbar-end gap-1">
    {
      isLoggedIn ? (
        <div class="dropdown dropdown-end">
          <button
            tabindex="0"
            role="button"
            type="button"
            aria-label="Menú de usuario administrador"
            aria-expanded="false"
            aria-haspopup="true"
            class="btn btn-ghost btn-circle"
          >
            <Avatar initial="A" size="xs" ring={false} interactive={false} />
          </button>
          <ul
            tabindex="0"
            class="menu menu-sm dropdown-content bg-base-100 border-base-200 z-50 mt-4 w-56 rounded-xl border p-2 shadow-md"
            role="menu"
            aria-label="Opciones de administrador"
          >
            <li class="menu-title text-base-content/60 text-xs uppercase">
              Administrador
            </li>

            <li>
              <a href="/admin">
                <Icon
                  name="material-symbols:space-dashboard-rounded"
                  size={18}
                />
                Panel de Control
              </a>
            </li>

            <li class="p-0" aria-hidden="true"><div class="divider m-0"></div></li>

            <li class="menu-title text-base-content/60 text-xs uppercase">
              Accesos Rápidos
            </li>

            <li>
              <a href="/admin/matches/create">
                <Icon
                  name="material-symbols:add-circle"
                  size={16}
                  class="text-primary"
                />
                Nuevo Partido
              </a>
            </li>
            <li>
              <a href="/admin/matches">
                <Icon
                  name="material-symbols:edit-document-rounded"
                  size={16}
                  class="text-secondary"
                />
                Historial de Partidos
              </a>
            </li>
            <li>
              <a href="/admin/players/create">
                <Icon
                  name="material-symbols:person-add"
                  size={16}
                  class="text-accent"
                />
                Nuevo Jugador
              </a>
            </li>
            <li>
              <a href="/admin/players">
                <Icon
                  name="material-symbols:list-alt"
                  size={16}
                  class="text-info"
                />
                Gestionar Plantel
              </a>
            </li>

            <li class="p-0" aria-hidden="true"><div class="divider m-0"></div></li>

            <li>
              <form
                action="/api/auth/signout"
                method="POST"
                class="btn btn-ghost text-error w-full"
              >
                <button
                  type="submit"
                  class="flex w-full cursor-pointer items-center gap-2"
                >
                  <Icon name="material-symbols:logout" size={16} />
                  Cerrar Sesión
                </button>
              </form>
            </li>
          </ul>
        </div>
      ) : (
        <a
          href="/login"
          class="btn btn-ghost btn-circle"
          aria-label="Acceso a panel de administración"
          data-tip="Acceso Admin"
        >
          <Icon
            name="material-symbols:lock-person"
            size={24}
            aria-hidden="true"
          />
        </a>
      )
    }

    <button
      type="button"
      class="btn btn-ghost btn-circle"
      aria-label="Buscar (Ctrl+K)"
      id="header-search-btn"
      title="Buscar (Ctrl+K)"
    >
      <Icon name="material-symbols:search" size={22} aria-hidden="true" />
    </button>

    <label class="btn btn-ghost btn-circle swap swap-rotate">
      <input
        id="theme-toggle"
        type="checkbox"
        class="theme-controller"
        value="dark"
        aria-label="Activar modo oscuro"
      />
      <script is:inline>
        if (localStorage.getItem("theme") === "dark") {
          document.getElementById("theme-toggle").checked = true;
        }
      </script>
      <Icon
        name="material-symbols:wb-sunny-rounded"
        class="swap-off"
        size={24}
        aria-hidden="true"
      />
      <Icon
        name="material-symbols:moon-stars"
        class="swap-on"
        size={24}
        aria-hidden="true"
      />
    </label>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggleShadow = () => {
    if (!header) return;
    const scrolled = window.scrollY > 4;
    header.classList.toggle("shadow-md", scrolled);
    header.classList.toggle("shadow-none", !scrolled);
  };

  toggleShadow();
  window.addEventListener("scroll", toggleShadow, { passive: true });

  const themeToggle = document.getElementById(
    "theme-toggle"
  ) as HTMLInputElement | null;
  if (themeToggle) {
    themeToggle.addEventListener("change", () => {
      const theme = themeToggle.checked ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
    });
  }

  document.getElementById("header-search-btn")?.addEventListener("click", () => {
    (document.getElementById("search-modal") as HTMLDialogElement)?.showModal();
    setTimeout(() => {
      (document.getElementById("search-input") as HTMLInputElement)?.focus();
    }, 100);
  });
</script>
