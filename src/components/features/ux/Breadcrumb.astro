---
import { Icon } from "astro-icon/components";
import { buildBreadcrumbs } from "@/lib/ux/breadcrumbs";

interface Props {
  pathname: string;
  playerNickname?: string;
}

const { pathname, playerNickname } = Astro.props;
const items = buildBreadcrumbs(pathname, playerNickname);
---

<nav class="breadcrumbs mb-4 text-sm" aria-label="Migas de pan">
  <ul>
    {
      items.map((item) =>
        item.href ? (
          <li>
            <a href={item.href} class="inline-flex items-center gap-1.5">
              {item.icon && <Icon name={item.icon} size={14} class="opacity-60" aria-hidden="true" />}
              {item.label}
            </a>
          </li>
        ) : (
          <li>
            <span class="inline-flex items-center gap-1.5">
              {item.icon && <Icon name={item.icon} size={14} class="opacity-60" aria-hidden="true" />}
              {item.label}
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
