---
import type { SearchItem } from "@/lib/ux/search";
import SearchInput from "@/components/ui/SearchInput.astro";
import { Icon } from "astro-icon/components";

interface Props {
  items?: SearchItem[];
}

const { items = [] } = Astro.props;
---

<dialog id="search-modal" class="modal" transition:persist="search-modal" data-items={JSON.stringify(items)}>
  <div class="modal-box w-full max-w-lg p-0">
    <SearchInput
      id="search-input"
      type="text"
      placeholder="Buscar jugadores, partidos, canchas..."
      ariaLabel="Buscar en SGSC"
      iconClass="h-6 w-6"
      class="input-ghost h-auto rounded-b-none border-b border-base-200 px-4 py-4 focus:outline-none focus-within:outline-none"
    >
      <kbd class="kbd kbd-sm text-base-content/40">Esc</kbd>
    </SearchInput>
    <div id="search-results" class="max-h-80 overflow-y-auto p-2"></div>
    <div id="search-empty" class="hidden p-8 text-center">
      <Icon
        name="material-symbols:search-off"
        class="text-base-content/20 mx-auto mb-2"
        size={40}
        aria-hidden="true"
      />
      <p class="text-base-content/60 text-sm">Sin resultados</p>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  import { loadRecents, saveRecent, CURATED_SUGGESTIONS, filterItems, type SearchItem } from "@/lib/ux/search";

  function escapeHTML(str: string): string {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  const WINNER_ICONS: Record<string, { svg: string; cls: string }> = {
    light: {
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>',
      cls: "text-warning bg-warning/10",
    },
    dark: {
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>',
      cls: "text-neutral bg-neutral/10",
    },
    draw: {
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 9h8M8 15h8"/></svg>',
      cls: "text-base-content/40 bg-base-200",
    },
  };

  function matchIcon(item: SearchItem): string {
    const w = item.meta?.winner ? WINNER_ICONS[item.meta.winner] : undefined;
    if (!w) return "";
    return `<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg ${w.cls}" title="${item.meta?.winner === "draw" ? "Empate" : `Ganó equipo ${item.meta?.winner === "light" ? "luz" : "sombra"}`}">${w.svg.replace("<svg", '<svg class="h-4 w-4"')}</div>`;
  }

  const getModal = () => document.getElementById("search-modal") as HTMLDialogElement | null;
  const getInput = () => document.getElementById("search-input") as HTMLInputElement | null;
  const getResultsDiv = () => document.getElementById("search-results") as HTMLElement | null;
  const getEmpty = () => document.getElementById("search-empty") as HTMLElement | null;

  let items: SearchItem[] = [];
  let isLoaded = false;
  let loadPromise: Promise<SearchItem[]> | null = null;

  function initItems() {
    if (items.length > 0) return;
    const modal = getModal();
    if (modal?.dataset.items) {
      try {
        const parsed = JSON.parse(modal.dataset.items);
        if (Array.isArray(parsed) && parsed.length > 0) {
          items = parsed;
          isLoaded = true;
        }
      } catch {}
    }
  }

  async function loadItems(): Promise<SearchItem[]> {
    initItems();
    if (isLoaded) return items;
    if (loadPromise) return loadPromise;

    loadPromise = (async () => {
      try {
        const cached = sessionStorage.getItem("sgsc:search-index");
        if (cached) {
          items = JSON.parse(cached);
          isLoaded = true;
          return items;
        }

        const res = await fetch("/api/search");
        if (res.ok) {
          const data = await res.json();
          items = data;
          sessionStorage.setItem("sgsc:search-index", JSON.stringify(data));
        }
      } catch {
      } finally {
        isLoaded = true;
      }
      return items;
    })();

    return loadPromise;
  }

  const typeLabels: Record<string, string> = {
    page: "Sugerencias",
    player: "Jugadores",
    match: "Partidos",
    field: "Canchas",
  };

  function itemHTML(item: import("@/lib/ux/search").SearchItem, withData = true): string {
    const attrs = withData
      ? `data-id="${escapeHTML(item.id)}" data-label="${escapeHTML(item.label)}" data-subtitle="${escapeHTML(item.subtitle)}" data-href="${escapeHTML(item.href)}" data-type="${escapeHTML(item.type)}"`
      : "";
    const icon =
      item.type === "match"
        ? matchIcon(item) ||
          `<div class="bg-base-200 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"><span class="text-base-content/60 text-xs font-bold">${escapeHTML(item.label.charAt(0))}</span></div>`
        : `<div class="bg-base-200 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"><span class="text-base-content/60 text-xs font-bold">${escapeHTML(item.label.charAt(0).toUpperCase())}</span></div>`;
    return `
      <a href="${escapeHTML(item.href)}" ${attrs} class="hover:bg-base-200 flex items-center gap-3 rounded-lg px-3 py-2 transition-colors">
        ${icon}
        <div class="min-w-0 flex-1">
          <div class="truncate text-sm font-medium">${escapeHTML(item.label)}</div>
          <div class="text-base-content/60 truncate text-xs">${escapeHTML(item.subtitle)}</div>
        </div>
      </a>
    `;
  }

  function groupHTML(type: string, typeItems: import("@/lib/ux/search").SearchItem[]): string {
    let html = `<div class="text-base-content/40 px-2 py-1 text-xs font-bold uppercase">${typeLabels[type] || type}</div>`;
    for (const item of typeItems.slice(0, 5)) {
      html += itemHTML(item);
    }
    return html;
  }

  function renderEmpty() {
    const resultsDiv = getResultsDiv();
    const empty = getEmpty();
    if (!resultsDiv || !empty) return;
    empty.classList.add("hidden");

    let html = "";
    const recents = loadRecents();
    if (recents.length > 0) {
      html += `<div class="text-base-content/40 px-2 pt-1 pb-1 text-xs font-bold uppercase">Recientes</div>`;
      for (const item of recents) html += itemHTML(item);
      html += `<div class="divider my-1"></div>`;
    }
    for (const item of CURATED_SUGGESTIONS.slice(0, 3)) html += itemHTML(item);

    resultsDiv.innerHTML = html;
  }

  function renderResults(query: string) {
    const resultsDiv = getResultsDiv();
    const empty = getEmpty();
    if (!resultsDiv || !empty) return;

    if (!query) {
      renderEmpty();
      return;
    }

    if (!isLoaded) {
      loadItems().then(() => {
        const currentInput = getInput();
        if (currentInput?.value) renderResults(currentInput.value);
      });
      return;
    }

    const grouped = new Map<string, import("@/lib/ux/search").SearchItem[]>();

    for (const item of filterItems(items, query)) {
      const group = grouped.get(item.type) || [];
      group.push(item);
      grouped.set(item.type, group);
    }

    const found: import("@/lib/ux/search").SearchItem[] = [];
    for (const [, groupItems] of grouped) {
      for (const item of groupItems.slice(0, 5)) {
        found.push(item);
      }
    }

    if (found.length === 0) {
      resultsDiv.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");

    let html = "";
    for (const [type, typeItems] of grouped) {
      html += groupHTML(type, typeItems);
    }

    resultsDiv.innerHTML = html;
  }

  function setupSearchModal() {
    const modal = getModal();
    const input = getInput();
    const resultsDiv = getResultsDiv();

    if (!modal || modal.dataset.paletteBound === "true") return;
    modal.dataset.paletteBound = "true";

    resultsDiv?.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest("a[data-id]") as HTMLAnchorElement | null;
      if (!anchor || !anchor.dataset.id) return;
      saveRecent({
        id: anchor.dataset.id,
        label: anchor.dataset.label || "",
        subtitle: anchor.dataset.subtitle || "",
        href: anchor.dataset.href || anchor.getAttribute("href") || "#",
        type: (anchor.dataset.type as SearchItem["type"]) || "page",
      });
      modal.close();
    });

    let debounceTimer: ReturnType<typeof setTimeout>;
    input?.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const currentInput = getInput();
        renderResults(currentInput?.value || "");
      }, 300);
    });

    input?.addEventListener("focus", () => loadItems(), { once: true });

    modal.addEventListener("close", () => {
      const currentInput = getInput();
      if (currentInput) currentInput.value = "";
      renderResults("");
    });
  }

  function openModal() {
    const modal = getModal();
    const input = getInput();
    if (!modal || modal.open) return;
    loadItems();
    modal.showModal();
    renderResults("");
    setTimeout(() => input?.focus(), 50);
  }

  function initHeaderSearchBtn() {
    const headerSearchBtn = document.getElementById("header-search-btn");
    if (!headerSearchBtn) return;
    headerSearchBtn.addEventListener("click", () => loadItems(), { once: true });
    headerSearchBtn.addEventListener("click", openModal);
  }

  function onKeydownPreload(e: KeyboardEvent) {
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      loadItems();
      document.removeEventListener("keydown", onKeydownPreload);
    }
  }
  document.addEventListener("keydown", onKeydownPreload);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      e.preventDefault();
      openModal();
    }
    const modal = getModal();
    if (e.key === "Escape" && modal?.open) {
      modal.close();
    }
  });

  setupSearchModal();
  initHeaderSearchBtn();

  document.addEventListener("astro:page-load", () => {
    const modal = getModal();
    if (modal?.open) {
      modal.close();
    }
    setupSearchModal();
    initHeaderSearchBtn();
  });
</script>
