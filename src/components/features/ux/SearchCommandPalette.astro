---
import { Icon } from "astro-icon/components";
import type { SearchItem } from "@/lib/ux/search";

interface Props {
  items: SearchItem[];
}

const { items } = Astro.props;
const serializedItems = JSON.stringify(items);
---

<dialog id="search-modal" class="modal" data-items={JSON.stringify(items)}>
  <div class="modal-box w-full max-w-lg p-0">
    <div class="flex items-center gap-3 border-b border-base-200 px-4 py-3">
      <Icon
        name="material-symbols:search"
        class="text-base-content/40 shrink-0"
        size={22}
        aria-hidden="true"
      />
      <input
        id="search-input"
        type="text"
        placeholder="Buscar jugadores, partidos, canchas..."
        class="w-full bg-transparent text-base outline-none"
        autocomplete="off"
        aria-label="Buscar en SGSC"
      />
      <kbd class="kbd kbd-sm text-base-content/40">Esc</kbd>
    </div>
    <div id="search-results" class="max-h-80 overflow-y-auto p-2"></div>
    <div id="search-empty" class="hidden p-8 text-center">
      <Icon
        name="material-symbols:search-off"
        class="text-base-content/20 mx-auto mb-2"
        size={40}
        aria-hidden="true"
      />
      <p class="text-base-content/60 text-sm">Sin resultados</p>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  import { loadRecents, saveRecent, CURATED_SUGGESTIONS, type SearchItem } from "@/lib/ux/search";

  function escapeHTML(str: string): string {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function fuzzyMatch(query: string, target: string): boolean {
    if (!query) return true;
    return target.toLowerCase().includes(query.toLowerCase());
  }

  const modal = document.getElementById("search-modal") as HTMLDialogElement | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const resultsDiv = document.getElementById("search-results") as HTMLElement | null;
  const empty = document.getElementById("search-empty") as HTMLElement | null;

  const items: SearchItem[] = JSON.parse(modal?.dataset.items || "[]");

  const typeLabels: Record<string, string> = {
    page: "Sugerencias",
    player: "Jugadores",
    match: "Partidos",
    field: "Canchas",
  };

  function itemHTML(item: import("@/lib/ux/search").SearchItem, withData = true): string {
    const attrs = withData
      ? `data-id="${escapeHTML(item.id)}" data-label="${escapeHTML(item.label)}" data-subtitle="${escapeHTML(item.subtitle)}" data-href="${escapeHTML(item.href)}" data-type="${escapeHTML(item.type)}"`
      : "";
    return `
      <a href="${escapeHTML(item.href)}" ${attrs} class="hover:bg-base-200 flex items-center gap-3 rounded-lg px-3 py-2 transition-colors">
        <div class="bg-base-200 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
          <span class="text-base-content/60 text-xs font-bold">${escapeHTML(item.label.charAt(0).toUpperCase())}</span>
        </div>
        <div class="min-w-0 flex-1">
          <div class="truncate text-sm font-medium">${escapeHTML(item.label)}</div>
          <div class="text-base-content/60 truncate text-xs">${escapeHTML(item.subtitle)}</div>
        </div>
      </a>
    `;
  }

  function groupHTML(type: string, typeItems: import("@/lib/ux/search").SearchItem[]): string {
    let html = `<div class="text-base-content/40 px-2 py-1 text-xs font-bold uppercase">${typeLabels[type] || type}</div>`;
    for (const item of typeItems.slice(0, 5)) {
      html += itemHTML(item);
    }
    return html;
  }

  function renderEmpty() {
    if (!resultsDiv || !empty) return;
    empty.classList.add("hidden");

    let html = "";
    const recents = loadRecents();
    if (recents.length > 0) {
      html += `<div class="text-base-content/40 px-2 pt-1 pb-1 text-xs font-bold uppercase">Recientes</div>`;
      for (const item of recents) html += itemHTML(item);
      html += `<div class="divider my-1"></div>`;
    }
    for (const item of CURATED_SUGGESTIONS.slice(0, 3)) html += itemHTML(item);

    resultsDiv.innerHTML = html;
  }

  function renderResults(query: string) {
    if (!resultsDiv || !empty) return;

    if (!query) {
      renderEmpty();
      return;
    }

    const grouped = new Map<string, import("@/lib/ux/search").SearchItem[]>();

    for (const item of items) {
      if (fuzzyMatch(query, item.label) || fuzzyMatch(query, item.subtitle)) {
        const group = grouped.get(item.type) || [];
        group.push(item);
        grouped.set(item.type, group);
      }
    }

    const found: import("@/lib/ux/search").SearchItem[] = [];
    for (const [, groupItems] of grouped) {
      for (const item of groupItems.slice(0, 5)) {
        found.push(item);
      }
    }

    if (found.length === 0) {
      resultsDiv.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");

    let html = "";
    for (const [type, typeItems] of grouped) {
      html += groupHTML(type, typeItems);
    }

    resultsDiv.innerHTML = html;
  }

  resultsDiv?.addEventListener("click", (e) => {
    const anchor = (e.target as HTMLElement).closest("a[data-id]") as HTMLAnchorElement | null;
    if (!anchor || !anchor.dataset.id) return;
    saveRecent({
      id: anchor.dataset.id,
      label: anchor.dataset.label || "",
      subtitle: anchor.dataset.subtitle || "",
      href: anchor.dataset.href || anchor.getAttribute("href") || "#",
      type: (anchor.dataset.type as SearchItem["type"]) || "page",
    });
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => renderResults(input?.value || ""), 300);
  });

  function openModal() {
    if (!modal || modal.open) return;
    modal.showModal();
    renderResults("");
    setTimeout(() => input?.focus(), 50);
  }

  document.getElementById("header-search-btn")?.addEventListener("click", openModal);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openModal();
    }
    if (e.key === "Escape" && modal?.open) {
      modal.close();
    }
  });

  modal?.addEventListener("close", () => {
    if (input) input.value = "";
    renderResults("");
  });
</script>
