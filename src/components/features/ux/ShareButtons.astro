---
import { Icon } from "astro-icon/components";

interface Props {
  targetSelector: string;
  filename: string;
}

const { targetSelector, filename } = Astro.props;
---

<div
  class="flex items-center gap-2"
  data-share-container
  data-share-target={targetSelector}
  data-share-filename={filename}
>
  <button
    type="button"
    class="btn btn-primary btn-sm rounded-xl gap-1.5 font-bold shadow-md"
    data-share-action="image"
    aria-label="Copiar imagen para compartir"
  >
    <span data-share-icon class="inline-flex">
      <Icon name="material-symbols:image" size={18} aria-hidden="true" />
    </span>
    <span
      data-share-loading
      class="loading loading-spinner hidden"
      aria-hidden="true"></span>
    <span data-share-label>Copiar imagen</span>
  </button>

  <span
    class="share-feedback hidden text-success text-xs font-bold"
    role="status"
    aria-live="polite">
  </span>
</div>

<script>
  import { toBlob } from "html-to-image";
  import {
    copyImageToClipboard,
    writeImageToClipboardWithPromise,
    pngWithPadding,
  } from "@/lib/ux/share";

  document.querySelectorAll("[data-share-container]").forEach((container) => {
    const el = container as HTMLElement;
    if (el.dataset.bound === "true") return;
    el.dataset.bound = "true";

    const btn = el.querySelector("[data-share-action='image']") as HTMLButtonElement | null;
    const feedback = el.querySelector(".share-feedback") as HTMLElement | null;
    const icon = el.querySelector("[data-share-icon]") as HTMLElement | null;
    const spinner = el.querySelector("[data-share-loading]") as HTMLElement | null;
    const label = el.querySelector("[data-share-label]") as HTMLElement | null;

    const setLoading = (loading: boolean) => {
      if (!btn) return;
      btn.disabled = loading;
      btn.setAttribute("aria-busy", loading ? "true" : "false");
      btn.classList.toggle("btn-disabled", loading);
      icon?.classList.toggle("hidden", loading);
      spinner?.classList.toggle("hidden", !loading);
      if (label) label.textContent = loading ? "Copiando..." : "Copiar imagen";
    };

    const showFeedback = (message: string) => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove("hidden");
      setTimeout(() => feedback.classList.add("hidden"), 2500);
    };

    const downloadFallback = (blob: Blob, name: string) => {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${name}.png`;
      a.click();
      URL.revokeObjectURL(url);
    };

    btn?.addEventListener("click", () => {
      const selector = el.dataset.shareTarget;
      const filenameAttr = el.dataset.shareFilename || "sgsc-compartir";
      const target = selector ? document.querySelector<HTMLElement>(selector) : null;
      if (!target || !btn || btn.disabled) return;

      setLoading(true);

      // Captura + margen. Se inicia YA dentro del gesto del usuario;
      // ClipboardItem acepta la promesa y resuelve después (patrón Safari).
      const capture: Promise<Blob> = (async () => {
        const bg = getComputedStyle(document.body).backgroundColor || "#ffffff";
        // La sombra se recorta mal en el borde de la captura: se aplana solo durante el render
        target.classList.add("share-capture-flat");
        try {
          const raw = await toBlob(target, {
            pixelRatio: 2,
            backgroundColor: bg,
            filter: (node: HTMLElement) =>
              !(node instanceof HTMLElement && node.hasAttribute("data-share-container")),
          });
          if (!raw) throw new Error("capture-failed");
          return pngWithPadding(raw, bg, 32);
        } finally {
          target.classList.remove("share-capture-flat");
        }
      })();

      const finish = async () => {
        let copied = await writeImageToClipboardWithPromise(capture);

        if (!copied) {
          try {
            copied = await copyImageToClipboard(await capture);
          } catch {
            copied = false;
          }
        }

        if (!copied) {
          try {
            downloadFallback(await capture, filenameAttr);
            showFeedback("Imagen descargada");
          } catch (err) {
            console.error("[share] no se pudo generar la imagen:", err);
            showFeedback("No se pudo generar la imagen");
          }
        } else {
          showFeedback("¡Imagen copiada!");
        }

        (window as unknown as { va?: { track?: (e: string, d: unknown) => void } }).va?.track?.(
          "share_clicked",
          { action: "image", copied },
        );

        setLoading(false);
      };

      void finish();
    });
  });
</script>
