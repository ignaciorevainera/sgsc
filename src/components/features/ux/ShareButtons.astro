---
import { Icon } from "astro-icon/components";
import { buildShareUrl } from "@/lib/ux/share";

interface Props {
  url: string;
  text: string;
  variant?: "compact" | "full";
}

const { url, text, variant = "compact" } = Astro.props;
const whatsappUrl = buildShareUrl("whatsapp", url, text);
const twitterUrl = buildShareUrl("twitter", url, text);
const isFull = variant === "full";
---

<div class="flex items-center gap-2" data-share-container data-share-url={url} data-share-text={text}>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`btn btn-circle border-none text-success-content hover:opacity-90 ${isFull ? "btn-md gap-1 px-3" : "btn-sm"} bg-success`}
    aria-label="Compartir por WhatsApp"
    title="WhatsApp"
    data-share-action="whatsapp"
  >
    <Icon name="material-symbols:chat-bubble" size={18} aria-hidden="true" />
    {isFull && <span class="text-xs font-bold">WhatsApp</span>}
  </a>

  <a
    href={twitterUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`btn btn-circle border-none text-info-content hover:opacity-90 ${isFull ? "btn-md gap-1 px-3" : "btn-sm"} bg-info`}
    aria-label="Compartir en X"
    title="X / Twitter"
    data-share-action="twitter"
  >
    <Icon name="material-symbols:alternate-email" size={18} aria-hidden="true" />
    {isFull && <span class="text-xs font-bold">X</span>}
  </a>

  <button
    type="button"
    class={`btn btn-circle btn-ghost border-base-300 border ${isFull ? "btn-md" : "btn-sm"}`}
    aria-label="Copiar enlace"
    title="Copiar enlace"
    data-share-action="copy"
  >
    <Icon name="material-symbols:content-copy" size={18} aria-hidden="true" />
  </button>

  <span class="share-feedback hidden text-xs font-bold text-success ml-1" role="status" aria-live="polite">
    ¡Copiado!
  </span>
</div>

<script>
  document.querySelectorAll("[data-share-container]").forEach((container) => {
    const el = container as HTMLElement;
    if (el.dataset.bound === "true") return;
    el.dataset.bound = "true";

    const copyBtn = el.querySelector("[data-share-action='copy']") as HTMLElement | null;
    const waLink = el.querySelector("[data-share-action='whatsapp']") as HTMLElement | null;
    const twLink = el.querySelector("[data-share-action='twitter']") as HTMLElement | null;
    const feedback = el.querySelector(".share-feedback") as HTMLElement | null;

    copyBtn?.addEventListener("click", async () => {
      const shareUrl = el.dataset.shareUrl || window.location.href;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        return;
      }
      if (feedback) {
        feedback.classList.remove("hidden");
        setTimeout(() => feedback.classList.add("hidden"), 2000);
      }
      (window as unknown as { va?: { track?: (e: string, d: unknown) => void } }).va?.track?.("share_clicked", { action: "copy", url: shareUrl });
    });

    const trackShare = (action: string) => {
      const shareUrl = el.dataset.shareUrl || window.location.href;
      (window as unknown as { va?: { track?: (e: string, d: unknown) => void } }).va?.track?.("share_clicked", { action, url: shareUrl });
    };

    waLink?.addEventListener("click", () => trackShare("whatsapp"));
    twLink?.addEventListener("click", () => trackShare("twitter"));
  });
</script>
