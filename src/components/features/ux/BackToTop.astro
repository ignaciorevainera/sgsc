---
// src/components/features/ux/BackToTop.astro
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  id="back-to-top"
  class="btn btn-circle btn-primary fixed right-4 bottom-[4.5rem] xl:bottom-4 z-40 hidden shadow-lg"
  aria-label="Volver arriba"
  title="Volver arriba"
>
  <Icon name="material-symbols:arrow-upward" size={22} aria-hidden="true" />
</button>

<script>
  const btn = document.getElementById("back-to-top") as HTMLButtonElement | null;

  const toggleVisibility = () => {
    if (!btn) return;
    if (window.scrollY > 400) {
      btn.classList.remove("hidden");
      btn.classList.add("flex");
    } else {
      btn.classList.add("hidden");
      btn.classList.remove("flex");
    }
  };

  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  window.addEventListener("scroll", toggleVisibility, { passive: true });
  toggleVisibility();
</script>
