---
interface Props {
  outcomes: string[];
}

const { outcomes } = Astro.props;

const dotClass: Record<string, string> = {
  A: "bg-primary",
  B: "bg-secondary",
  D: "bg-warning",
};
---

{
  outcomes.length === 0 ? (
    <p class="text-sm opacity-50">Sin enfrentamientos aún</p>
  ) : (
    <div class="flex flex-wrap items-center justify-center gap-2" aria-label="Línea de tiempo de enfrentamientos">
      {outcomes.map((o) => (
        <span class:list={["h-4 w-4 rounded-full", dotClass[o] ?? "bg-base-300"]} />
      ))}
    </div>
  )
}
