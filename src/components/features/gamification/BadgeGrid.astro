---
import BadgeCard from "./BadgeCard.astro";
import type { PlayerBadges } from "@/lib/gamification/badges";
import { TIER_STYLES } from "@/lib/gamification/types";
import type { TierKey } from "@/lib/gamification/types";

interface Props {
  badges: PlayerBadges;
}

const { badges } = Astro.props;

const groups = [
  { id: "trayectoria", label: "Trayectoria" },
  { id: "rachas", label: "Rachas" },
  { id: "duplas", label: "Duplas" },
  { id: "especial", label: "Especiales" },
];
---

<div class="space-y-4">
  <form class="flex flex-wrap justify-center gap-2" id="badge-filter">
    <button type="reset" class="btn btn-ghost btn-sm md:btn-md rounded-xl">
      Todas
    </button>
    {groups.map((g) => (
      <label class="btn btn-sm md:btn-md has-checked:btn-primary cursor-pointer rounded-xl">
        <input type="checkbox" class="sr-only" name="badge-group" value={g.id} aria-label={g.label} />
        {g.label}
      </label>
    ))}
  </form>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" id="badge-grid">
    {badges.earned.map((b) => (
      <div class="h-full" data-group-item={b.category}>
        <BadgeCard name={b.name} icon={b.icon} description={b.description} howToGet={b.howToGet} tier={b.tier} />
      </div>
    ))}
    {badges.progress.map((p) => (
      <div class="h-full" data-group-item={p.category}>
        <BadgeCard
          name={p.name}
          icon={p.icon}
          description={`${p.current} / ${p.nextThreshold} para ${TIER_STYLES[p.nextTier as TierKey].name}`}
          howToGet={p.howToGet}
          tier={p.nextTier as TierKey}
          progress={p.progress}
          locked
        />
      </div>
    ))}
    {badges.locked.map((b) => (
      <div class="h-full" data-group-item="especial">
        <BadgeCard
          name={b.name}
          icon={b.icon}
          description={b.description}
          howToGet={b.howToGet}
          tier={null}
          locked
        />
      </div>
    ))}
  </div>
</div>

<script>
  const form = document.getElementById("badge-filter") as HTMLFormElement | null;
  const boxes = form?.querySelectorAll<HTMLInputElement>("input[name='badge-group']");
  const items = document.querySelectorAll<HTMLElement>("[data-group-item]");

  const applyFilter = () => {
    if (!boxes || !items) return;
    const active = new Set(
      Array.from(boxes)
        .filter((b) => b.checked)
        .map((b) => b.value),
    );
    items.forEach((item) => {
      const match = active.size === 0 || active.has(item.dataset.groupItem ?? "");
      item.style.display = match ? "" : "none";
    });
  };

  boxes?.forEach((box) => {
    box.addEventListener("change", applyFilter);
  });

  form?.addEventListener("reset", () => {
    requestAnimationFrame(applyFilter);
  });
</script>
