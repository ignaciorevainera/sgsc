---
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
);

import { Icon } from "astro-icon/components";
import { createAstroSupabase } from "@/lib/supabase";
import { getCurrentYear } from "@/lib/utils/dateUtils";
import { getRandomHero } from "@/lib/hero";
import Alert from "@/components/shared/Alert.astro";
import Hero from "@/components/sections/Hero.astro";
import LiveMatchCounter from "@/components/index/LiveMatchCounter.astro";
import Main from "@/layouts/Main.astro";
import MatchCard from "@/components/MatchCard.astro";

const supabase = createAstroSupabase(Astro);
const currentYear = getCurrentYear();
const heroImage = getRandomHero();

const [
  { error: matchesCountError },
  { data: lastMatchData },
  { data: topPlayersData },
] = await Promise.all([
  supabase.from("matches").select("id", { count: "exact", head: true }),
  supabase
    .from("matches")
    .select(
      `
      id,
      date,
      result,
      video_url,
      fields (name),
      match_players (
        team,
        players (nickname)
      )
    `,
    )
    .order("date", { ascending: false })
    .limit(1),
  supabase
    .from("view_player_stats_yearly")
    .select("player_id, nickname, matches_played, wins, points")
    .eq("year", currentYear)
    .eq("is_guest", false)
    .order("points", { ascending: false })
    .limit(3),
]);

const lastMatch = lastMatchData?.[0];
const topPlayers = topPlayersData ?? [];
const hasConnectionError = !!matchesCountError;

// --- CONFIGURACIÓN UI ---

const features = [
  {
    title: "Tabla de Posiciones",
    kicker: "Competencia",
    description: "Mira quién lidera el torneo y la lucha por el campeonato.",
    icon: "material-symbols:trophy",
    href: "/ranking",
    color: "bg-amber-500/10 text-amber-600 dark:text-amber-400",
    ring: "group-hover:ring-amber-500/30",
  },
  {
    title: "Salón de la Fama",
    kicker: "Historia",
    description: "Los récords históricos y leyendas del club.",
    icon: "material-symbols:workspace-premium",
    href: "/hall-of-fame",
    color: "bg-purple-500/10 text-purple-600 dark:text-purple-400",
    ring: "group-hover:ring-purple-500/30",
  },
  {
    title: "Plantel de Jugadores",
    kicker: "Equipo",
    description: "Perfiles detallados y estadísticas individuales.",
    icon: "material-symbols:groups",
    href: "/players",
    color: "bg-blue-500/10 text-blue-600 dark:text-blue-400",
    ring: "group-hover:ring-blue-500/30",
  },
];
---

<Main title="Inicio | SGSC" heroImage={heroImage}>
  <Hero heroImage={heroImage} />

  <section class="container mx-auto space-y-12 pb-12">
    {/* Alerta de error de conexión */}
    {
      hasConnectionError && (
        <Alert
          type="error"
          message="Hubo un problema al cargar los datos. Algunas secciones pueden no mostrarse correctamente."
          class="mb-6"
        />
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-9">
      <!-- Líderes: 5 columnas en desktop -->
      <div class="lg:col-span-3">
        <div class="mb-4 flex items-center justify-between gap-2">
          <div class="flex items-center gap-3">
            <span
              class="bg-warning/10 border-warning/20 text-warning flex h-10 w-10 items-center justify-center rounded-xl border"
              aria-hidden="true"
            >
              <Icon name="material-symbols:trophy" size={22} />
            </span>
            <h2 class="text-xl font-black uppercase italic">
              Líderes {currentYear}
            </h2>
          </div>
          <a href="/ranking" class="btn btn-ghost btn-xs">
            Tabla
            <Icon
              name="material-symbols:arrow-forward"
              size={16}
              aria-hidden="true"
            />
          </a>
        </div>

        <div
          class="card bg-base-100 border-base-200 rounded-xl border shadow-md"
        >
            <div class="card-body p-0 first:[&_a]:rounded-t-xl last:[&_a]:rounded-b-xl">
            {
              topPlayers && topPlayers.length > 0 ? (
                <div class="divide-base-200 divide-y">
                  {topPlayers.map((player, index) => (
                    <a
                      href={`/players/${player.player_id}`}
                      class="hover:bg-base-200 group flex items-center justify-between p-4 transition-colors"
                      aria-label={`${index + 1} ${player.nickname}: ${player.matches_played} PJ, ${player.wins} Victorias, ${player.points} PTS`}
                    >
                      <div class="flex items-center gap-4">
                        <div
                          class={`flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold ${index === 0 ? "bg-amber-100 text-amber-700 ring-2 ring-amber-400" : ""} ${index === 1 ? "bg-slate-100 text-slate-600 ring-2 ring-slate-300" : ""} ${index === 2 ? "bg-orange-100 text-orange-700 ring-2 ring-orange-300" : ""} `}
                        >
                          {index + 1}
                        </div>

                        <div>
                          <div class="group-hover:text-primary font-bold transition-colors">
                            {player.nickname}
                          </div>
                          <div class="text-base-content/60 text-xs">
                            {player.matches_played} PJ • {player.wins} Victorias
                          </div>
                        </div>
                      </div>

                      <div class="text-right">
                        <div class="text-primary text-xl font-black">
                          {player.points}
                        </div>
                        <div class="text-base-content/60 text-xs font-bold uppercase">
                          PTS
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="text-base-content/60 p-6 text-center italic">
                  Aún no hay datos suficientes para el ranking.
                </div>
              )
            }
          </div>
        </div>
      </div>

      <!-- Último Resultado: 6 columnas en desktop -->
      <div class="flex flex-col lg:col-span-6">
        <div class="mb-4 flex items-center justify-between gap-2">
          <div class="flex items-center gap-3">
            <span
              class="bg-primary/10 border-primary/20 text-primary flex h-10 w-10 items-center justify-center rounded-xl border"
              aria-hidden="true"
            >
              <Icon name="material-symbols:history" size={22} />
            </span>
            <h2 class="text-xl font-black uppercase italic">
              Último resultado
            </h2>
          </div>
          <a href="/matches" class="btn btn-ghost btn-xs">
            Historial
            <Icon
              name="material-symbols:arrow-forward"
              size={16}
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="flex-1 [&>div]:h-full [&>div>.card-body]:h-full">
          {
            lastMatch ? (
              <MatchCard match={lastMatch} />
            ) : (
              <div class="alert bg-base-100 border-base-200 rounded-xl border shadow-md">
                <Icon
                  name="material-symbols:info"
                  class="text-info"
                  size={20}
                />
                <span>No hay partidos registrados recientemente.</span>
              </div>
            )
          }
        </div>

        <LiveMatchCounter matchDate={lastMatch?.date ?? null} />
      </div>

      <!-- Feature Cards: 3 columnas cada una -->
      {
        features.map((feature) => (
          <a
            href={feature.href}
            class={`card bg-base-100 border-base-200 group rounded-xl border shadow-md ring-1 ring-transparent transition-all hover:-translate-y-1 hover:shadow-lg lg:col-span-3 ${feature.ring}`}
            aria-label={`${feature.kicker}: ${feature.title}. ${feature.description}`}
          >
            <div class="card-body gap-3">
              <div class="flex items-start justify-between">
                <div
                  class={`flex h-12 w-12 items-center justify-center rounded-xl ${feature.color}`}
                  aria-hidden="true"
                >
                  <Icon name={feature.icon} size={28} />
                </div>
                <Icon
                  name="material-symbols:arrow-outward"
                  size={20}
                  aria-hidden="true"
                  class="text-base-content/30 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"
                />
              </div>
              <div>
                <p class="text-base-content/60 text-[11px] font-bold tracking-[0.18em] uppercase">
                  {feature.kicker}
                </p>
                <h3 class="text-lg leading-snug font-extrabold tracking-tight group-hover:text-primary transition-colors">
                  {feature.title}
                </h3>
              </div>
              <p class="text-base-content/60 text-sm">{feature.description}</p>
            </div>
          </a>
        ))
      }

      <!-- Info Alert: 9 columnas -->
      <div
        class="alert bg-primary/5 border-base-200 text-base-content rounded-xl border shadow-md lg:col-span-9"
        role="note"
      >
        <Icon
          name="material-symbols:info-outline"
          class="text-primary"
          size={24}
          aria-hidden="true"
        />
        <div>
          <h3 class="text-primary font-bold">¿Cuándo se juega?</h3>
          <p class="text-base-content/60 text-xs">
            Organiza el próximo partido desde el grupo de WhatsApp oficial.
          </p>
        </div>
      </div>
    </div>
  </section>
</Main>
