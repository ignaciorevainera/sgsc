      bronze: { ...tierStyles.bronze, threshold: 3 },
      silver: { ...tierStyles.silver, threshold: 5 },
      gold: { ...tierStyles.gold, threshold: 7 },
    },
  },
  {
    id: "duplas",
    name: "Duplas",
    icon: "material-symbols:group-add",
    description: "Celebra la química con un compañero constante.",
    metric: "Victorias con mismo compañero",
    tiers: {
