  },
  {
    id: "nemesis",
    name: "Némesis",
    icon: "material-symbols:swords",
    description: "Dominio sobre un rival específico.",
    howToGet: "Vencer al mismo rival 5 o más veces.",
    style: "bg-red-50 text-red-700 border-red-400 dark:bg-red-950/60 dark:text-red-300 dark:border-red-700",
  },
  {
    id: "clutch-king",
    name: "Sangre Fría",
    icon: "material-symbols:whatshot",
    description: "Rendimiento máximo en los últimos partidos.",
    howToGet: "Lograr 80%+ de victorias en los últimos 5 partidos.",
    style: "bg-amber-50 text-amber-800 border-amber-400 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-700",
