---
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");

import { createAstroSupabase } from "@/lib/supabase";
import { getCurrentYear } from "@/lib/utils/dateUtils";
import EmptyState from "@/components/features/ux/EmptyState.astro";
import ErrorRetry from "@/components/features/ux/ErrorRetry.astro";
import Main from "@/layouts/Main.astro";
import StandingsLegend from "@/components/ranking/StandingsLegend.astro";
import StandingsTable from "@/components/ranking/StandingsTable.astro";
import Title from "@/components/shared/Title.astro";
import ShareButtons from "@/components/features/ux/ShareButtons.astro";
import { Icon } from "astro-icon/components";

const supabase = createAstroSupabase(Astro);

// 1. Obtener Años Disponibles Dinámicamente
const { data: yearsData } = await supabase
  .from("view_player_stats_yearly")
  .select("year");
// Filtramos años únicos y ordenamos descendente (2025, 2024...)
const availableYears = [...new Set(yearsData?.map((y) => y.year))].sort(
  (a, b) => (b || 0) - (a || 0),
);
const currentYear = String(getCurrentYear());
// Si no hay datos, usamos el año actual como fallback
const defaultYear =
  availableYears.length > 0 ? String(availableYears[0]) : currentYear;

// 2. URL Params
const sort = Astro.url.searchParams.get("sort") || "points";
const season = Astro.url.searchParams.get("season") || defaultYear;
const mode = Astro.url.searchParams.get("mode") || "simple";
// Mínimo de partidos: solo enteros positivos mayores a 1; cualquier otro valor se ignora
const minMatchesParam = Number(Astro.url.searchParams.get("min_matches"));
const minMatches =
  Number.isInteger(minMatchesParam) && minMatchesParam > 1 ? minMatchesParam : 0;

// Construimos las opciones del selector incluyendo "Histórico"
const seasons = [...availableYears.map(String), "Histórico"];
// Si por alguna razón la lista está vacía (BD nueva), ponemos el año actual
if (seasons.length === 1) seasons.unshift(currentYear);

const sortOptions = [
  { value: "points", label: "Puntos" },
  { value: "name", label: "Nombre" },
  { value: "streak", label: "Racha" },
  { value: "matches", label: "Partidos Jugados" },
  { value: "wins", label: "Victorias" },
  { value: "draws", label: "Empates" },
  { value: "losses", label: "Derrotas" },
  { value: "winRate", label: "% Victorias" },
  { value: "drawRate", label: "% Empates" },
  { value: "lossRate", label: "% Derrotas" },
];

// 3. Consulta SQL
let query;
if (season === "Histórico") {
  query = supabase.from("view_player_stats_all_time").select("player_id, nickname, matches_played, wins, draws, losses, points, win_pct, attendance_pct, form_array, is_guest");
} else {
  query = supabase
    .from("view_player_stats_yearly")
    .select("player_id, nickname, matches_played, wins, draws, losses, points, win_rate, draw_rate, loss_rate, attendance_pct, form_array, effectiveness, is_guest")
    .eq("year", Number(season));
}

// Filtramos solo socios (no invitados)
// AHORA ESTO FUNCIONARÁ PORQUE LA VISTA YA TIENE 'is_guest'
const { data: rawPlayers, error } = await query.eq("is_guest", false);

const { data: streaksData } = await supabase
  .from("view_player_streaks")
  .select("player_id, current_streak_type, current_streak_length");
const streakByPlayer = new Map(
  (streaksData ?? []).map((s) => [s.player_id, s]),
);

const hasError = !!error;
const hasPlayersStats = !hasError && rawPlayers && rawPlayers.length > 0;

// 4. Mapeo de datos
const players =
  rawPlayers?.map((p: any) => ({
    ...p,
    matches: p.matches_played,
    // Mapeamos los campos nuevos de la vista SQL
    attendance_percentage: p.attendance_pct || 0,

    // La vista histórica usa win_pct; la anual usa win_rate/draw_rate/loss_rate.
    // Unificamos campos para que la tabla funcione en ambos modos.
    win_pct: p.win_rate ?? p.win_pct ?? 0,
    draw_pct:
      p.draw_rate ??
      (p.matches_played > 0
        ? Math.round((p.draws / p.matches_played) * 100)
        : 0),
    loss_pct:
      p.loss_rate ??
      (p.matches_played > 0
        ? Math.round((p.losses / p.matches_played) * 100)
        : 0),

    // En histórico puede no existir en la vista.
    form_array: p.form_array || [],

    // Fallback para histórico: usar % de victorias.
    effectiveness: p.effectiveness ?? p.win_rate ?? p.win_pct ?? 0,

    current_streak_type: streakByPlayer.get(p.player_id)?.current_streak_type ?? null,
    current_streak_length: streakByPlayer.get(p.player_id)?.current_streak_length ?? 0,
  })) || [];

// 5. Filtro por mínimo de partidos
const minFilteredPlayers = minMatches > 0
  ? players.filter((p) => p.matches_played >= minMatches)
  : players;

// 6. Ordenamiento
const sortedPlayers = [...minFilteredPlayers].sort((a, b) => {
  switch (sort) {
    case "name":
      return a.nickname.localeCompare(b.nickname);
    case "streak":
      return b.current_streak_length - a.current_streak_length;
    case "matches":
      return b.matches - a.matches;
    case "wins":
      return b.wins - a.wins;
    case "draws":
      return b.draws - a.draws;
    case "losses":
      return b.losses - a.losses;
    case "attendance":
      return b.attendance_percentage - a.attendance_percentage;
    // Ordenar por porcentajes usa las tasas
    case "winRate":
      return b.win_pct - a.win_pct;
    case "drawRate":
      return b.draw_pct - a.draw_pct;
    case "lossRate":
      return b.loss_pct - a.loss_pct;
    default:
      // Criterio por defecto: Puntos > Efectividad (no win_rate) > Partidos
      if (b.points !== a.points) return b.points - a.points;
      if (b.effectiveness !== a.effectiveness)
        return b.effectiveness - a.effectiveness;
      return b.matches - a.matches;
  }
});
---

<Main title="Clasificación | SGSC">
  <Title
    title="Clasificación"
    subtitle={season === "Histórico"
      ? "Histórico Global"
      : `Temporada ${season}`}
  />

  <div class="flex justify-end mb-4">
    <ShareButtons
      targetSelector="#ranking-table-card"
      filename="sgsc-clasificacion"
    />
  </div>

  <div
    class="bg-base-100 border-base-200 mb-6 flex flex-col gap-2 rounded-xl border p-4 shadow-md sm:flex-row sm:items-center sm:gap-4"
  >
    <div
      class="flex w-full flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      {/* Selector de Temporada */}
      <div class="form-control w-full">
        <label for="season" class="label py-1">
          <span
            class="label-text text-base-content/60 text-xs font-bold uppercase"
            >Temporada</span
          >
        </label>
        <select
          id="season"
          name="season"
          class="select select-sm md:select-md w-full rounded-xl"
          aria-label="Seleccionar temporada"
        >
          {
            seasons.map((s) => (
              <option value={s} selected={String(season) === String(s)}>
                {s}
              </option>
            ))
          }
        </select>
      </div>

      {/* Selector de Orden */}
      <div class="form-control w-full">
        <label for="sort" class="label py-1">
          <span
            class="label-text text-base-content/60 text-xs font-bold uppercase"
            >Ordenar por</span
          >
        </label>
        <select
          id="sort"
          name="sort"
          class="select select-sm md:select-md w-full rounded-xl"
          aria-label="Seleccionar criterio de ordenamiento"
        >
          {
            sortOptions.map((o) => (
              <option value={o.value} selected={sort === o.value}>
                {o.label}
              </option>
            ))
          }
        </select>
      </div>
    </div>

    <div class="divider m-0 sm:hidden"></div>

    {/* Toggle Vista Detallada (Móvil) */}
    <div class="form-control w-full sm:hidden">
      <label
        for="mode-toggle"
        class="label cursor-pointer justify-start gap-3 p-0"
      >
        <span class="text-base-content/60 text-xs font-bold uppercase"
          >Vista Detallada</span
        >
        <input
          id="mode-toggle"
          type="checkbox"
          class="toggle toggle-primary toggle-sm"
          checked={mode === "detailed"}
          role="switch"
          aria-checked={mode === "detailed" ? "true" : "false"}
        />
      </label>
    </div>

    <div class="divider m-0 sm:hidden"></div>

    <div class="form-control w-full">
      <label for="min_matches" class="label py-1">
        <span class="label-text text-base-content/60 text-xs font-bold uppercase">Mín. Partidos</span>
      </label>
      <input
        id="min_matches"
        name="min_matches"
        type="text"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="3"
        value={minMatches || ""}
        placeholder="Sin mínimo"
        class="input input-sm md:input-md w-full rounded-xl"
        aria-label="Filtrar por mínimo de partidos jugados, entero mayor a 1"
      />
    </div>

    {/* Reset de filtros */}
    <a
      href="/ranking"
      class="btn btn-ghost btn-sm md:btn-md w-full shrink-0 gap-1.5 self-end rounded-xl sm:w-auto sm:self-center"
      aria-label="Limpiar todos los filtros"
    >
      <Icon name="material-symbols:restart-alt" size={18} aria-hidden="true" />
      Limpiar
    </a>
  </div>

  {/* Error de conexión */}
  {
    hasError && (
      <ErrorRetry message="No se pudo cargar la clasificación. Por favor, intenta más tarde." />
    )
  }

  {/* Sin datos para la temporada */}
  {
    !hasError && !hasPlayersStats && (
      <EmptyState
        icon="material-symbols:leaderboard"
        title="Sin datos"
        description={`No hay partidos registrados para la temporada ${season}.`}
      />
    )
  }

  {/* Tabla de clasificación */}
  {
    hasPlayersStats && (
      <div class="space-y-6">
        <div id="ranking-table-card">
          <StandingsTable
            players={sortedPlayers}
            showDetails={mode === "detailed"}
          />
        </div>
        <StandingsLegend />
      </div>
    )
  }
</Main>

<script>
  const s = document.getElementById("season") as HTMLSelectElement;
  const o = document.getElementById("sort") as HTMLSelectElement;
  const m = document.getElementById("mode-toggle") as HTMLInputElement;
  const mm = document.getElementById("min_matches") as HTMLInputElement;

  let debounceTimer: ReturnType<typeof setTimeout>;

  const update = () => {
    const url = new URL(window.location.href);
    if (s) url.searchParams.set("season", s.value);
    if (o) url.searchParams.set("sort", o.value);
    if (m) url.searchParams.set("mode", m.checked ? "detailed" : "simple");
    const mv = parseInt(mm?.value ?? "", 10);
    if (!isNaN(mv) && mv > 1) url.searchParams.set("min_matches", String(mv));
    else url.searchParams.delete("min_matches");
    window.location.href = url.toString();
  };

  s?.addEventListener("change", update);
  o?.addEventListener("change", update);
  m?.addEventListener("change", update);
  mm?.addEventListener("input", () => {
    // Solo dígitos, sin ceros a la izquierda, máximo 3 caracteres
    const clean = mm.value.replace(/\D/g, "").replace(/^0+/, "").slice(0, 3);
    if (clean !== mm.value) mm.value = clean;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(update, 500);
  });
</script>
