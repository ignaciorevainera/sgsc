---
import { createAstroSupabase } from "@/lib/supabase";
import { Icon } from "astro-icon/components";
import PlayerFormFields from "@/components/admin/PlayerFormFields.astro";

import {
  formDataToPlayerInput,
  playerSchema,
  toFieldErrors,
} from "@/lib/schemas/adminSchemas";
import Main from "@/layouts/Main.astro";
import Title from "@/components/shared/Title.astro";

const supabase = createAstroSupabase(Astro);

const id = Astro.params.id as string;
if (!id) return Astro.redirect("/admin/players");

// Obtener datos actuales
const { data: player } = await supabase
  .from("players")
  .select(
    "id, nickname, first_name, last_name, birth_date, preferred_foot, is_guest, is_active",
  )
  .eq("id", id)
  .single();
if (!player) return Astro.redirect("/admin/players");

let errorMessage = "";
let fieldErrors: Record<string, string> = {};
let formValues: {
  nickname: string;
  first_name: string;
  last_name: string;
  birth_date: string;
  preferred_foot: "right" | "left" | "both" | null;
  is_guest: boolean;
} = {
  nickname: player.nickname ?? "",
  first_name: player.first_name ?? "",
  last_name: player.last_name ?? "",
  birth_date: player.birth_date ?? "",
  preferred_foot: (player.preferred_foot === "right" || player.preferred_foot === "left" || player.preferred_foot === "both" ? player.preferred_foot : null),
  is_guest: player.is_guest ?? false,
};

// --- UPDATE ---
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "toggle_status") {
    const newStatus = !player.is_active;
    const { error: updateError } = await supabase
      .from("players")
      .update({ is_active: newStatus })
      .eq("id", id);

    if (updateError) {
      errorMessage = updateError.message;
    } else {
      return Astro.redirect(`/admin/players/edit/${id}?toast=success&msg=Estado+actualizado+correctamente`);
    }
  } else {
    const rawFoot = formData.get("preferred_foot")?.toString().trim() ?? "";
    formValues = {
      nickname: (formData.get("nickname")?.toString() ?? ""),
      first_name: (formData.get("first_name")?.toString() ?? ""),
      last_name: (formData.get("last_name")?.toString() ?? ""),
      birth_date: (formData.get("birth_date")?.toString() ?? ""),
      preferred_foot: (rawFoot === "right" || rawFoot === "left" || rawFoot === "both" ? rawFoot : null),
      is_guest: formData.get("is_guest") === "on" || formData.get("is_guest") === "true",
    };

    const parsed = playerSchema.safeParse(formDataToPlayerInput(formData));
    if (!parsed.success) {
      fieldErrors = toFieldErrors(parsed.error);
      errorMessage = "Revisa los campos marcados en rojo.";
    } else {
      const { name: _ignored, ...playerInput } = parsed.data;
      const { error: updateError } = await supabase
        .from("players")
        .update({ ...playerInput })
        .eq("id", id);

      if (updateError) {
        errorMessage = updateError.message;
      } else {
        return Astro.redirect(`/admin/players/edit/${id}?toast=success&msg=Jugador+actualizado+correctamente`);
      }
    }
  }
}
---

<Main
  title="Editar Jugador"
  contentWidth="admin"
  toastType={errorMessage ? "error" : undefined}
  toastMessage={errorMessage || undefined}
>
  <Title title="Editar Jugador" subtitle="Panel de Administración" />

  <div class="flex max-w-full flex-col gap-4 overflow-hidden sm:gap-6">
    <form
      method="POST"
      class="card bg-base-100 border-base-200 max-w-full space-y-4 overflow-hidden rounded-xl border p-3.5 shadow-md sm:space-y-6 sm:p-6"
    >
      <input type="hidden" name="action" value="update" />
      <PlayerFormFields
        idPrefix={`edit-player-${id}`}
        values={formValues}
        errors={fieldErrors}
      />

      <button type="submit" class="btn btn-primary btn-sm sm:btn-md min-h-[44px] w-full rounded-xl shadow-md"
        >Actualizar Datos</button
      >
    </form>

    <div class="card bg-base-200 border-base-200 max-w-full rounded-xl border p-3.5 overflow-hidden sm:p-6">
      <h3 class="text-base-content/60 mb-2 text-xs font-bold uppercase">
        Zona de Estado
      </h3>
      <div class="flex items-center justify-between gap-2">
        <div>
          <span class="block font-bold">Estado Actual</span>
          <span class="text-xs opacity-70">
            {
              player.is_active
                ? "El jugador aparece en las listas."
                : "El jugador está archivado."
            }
          </span>
        </div>

        <form method="POST">
          <input type="hidden" name="action" value="toggle_status" />
          {
            player.is_active ? (
              <button class="btn btn-error btn-sm sm:btn-md rounded-xl text-white">
                <Icon name="material-symbols:archive" /> Desactivar
              </button>
            ) : (
              <button class="btn btn-success btn-sm sm:btn-md rounded-xl text-white">
                <Icon name="material-symbols:unarchive" /> Reactivar
              </button>
            )
          }
        </form>
      </div>
    </div>
  </div>
</Main>
