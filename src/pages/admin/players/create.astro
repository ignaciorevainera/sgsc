---
import { createAstroSupabase } from "@/lib/supabase";
import { Icon } from "astro-icon/components";
import PlayerFormFields from "@/components/admin/PlayerFormFields.astro";
import {
  formDataToPlayerInput,
  playerSchema,
  toFieldErrors,
} from "@/lib/schemas/adminSchemas";
import Main from "@/layouts/Main.astro";
import Title from "@/components/shared/Title.astro";

const supabase = createAstroSupabase(Astro);
let errorMessage = "";
let fieldErrors: Record<string, string> = {};
let formValues: {
  nickname: string;
  first_name: string;
  last_name: string;
  birth_date: string;
  preferred_foot: "right" | "left" | "both" | null;
  is_guest: boolean;
} = {
  nickname: "",
  first_name: "",
  last_name: "",
  birth_date: "",
  preferred_foot: null,
  is_guest: false,
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const parsed = playerSchema.safeParse(formDataToPlayerInput(formData));

  const rawFoot = formData.get("preferred_foot")?.toString().trim() ?? "";
  formValues = {
    nickname: (formData.get("nickname")?.toString().trim() ?? ""),
    first_name: (formData.get("first_name")?.toString() ?? ""),
    last_name: (formData.get("last_name")?.toString() ?? ""),
    birth_date: (formData.get("birth_date")?.toString() ?? ""),
    preferred_foot: (rawFoot === "right" || rawFoot === "left" || rawFoot === "both" ? rawFoot : null),
    is_guest: formData.get("is_guest") === "on" || formData.get("is_guest") === "true",
  };

  if (!parsed.success) {
    fieldErrors = toFieldErrors(parsed.error);
    errorMessage = fieldErrors._form || "Revisa los campos marcados en rojo.";
  } else {
    const { name: _ignored, ...playerInput } = parsed.data;
    const { error } = await supabase.from("players").insert({
      ...playerInput,
    });

    if (error) {
      errorMessage = error.message;
    } else {
      return Astro.redirect("/admin/players?toast=success&msg=Jugador+creado+correctamente");
    }
  }
}
---

<Main
  title="Nuevo Jugador"
  contentWidth="admin"
  toastType={errorMessage ? "error" : undefined}
  toastMessage={errorMessage || undefined}
>
  <Title title="Nuevo Jugador" subtitle="Panel de Administración" />

  <div class="flex max-w-full flex-col gap-4 overflow-hidden sm:gap-6">
    <form
      id="playerForm"
      method="POST"
      class="card bg-base-100 border-base-200 max-w-full space-y-4 overflow-hidden rounded-xl border p-3.5 shadow-md sm:space-y-6 sm:p-6"
    >
      <PlayerFormFields idPrefix="create-player" values={formValues} errors={fieldErrors} />
    </form>

    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
      <button
        type="submit"
        form="playerForm"
        class="btn btn-primary btn-sm sm:btn-md min-h-[44px] w-full rounded-xl sm:flex-1"
      >
        <Icon name="material-symbols:save" size={20} aria-hidden="true" />
        Guardar Jugador
      </button>

      <a
        href="/admin/players"
        class="btn btn-outline btn-error btn-sm sm:btn-md min-h-[44px] w-full rounded-xl sm:flex-1"
      >
        <Icon name="material-symbols:arrow-back" size={18} aria-hidden="true" />
        Cancelar
      </a>
    </div>
  </div>
</Main>
