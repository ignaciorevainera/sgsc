---
import { createAstroSupabase } from "@/lib/supabase";
import { Icon } from "astro-icon/components";
import Main from "@/layouts/Main.astro";
import Title from "@/components/shared/Title.astro";
import {
  formDataToMatchInput,
  matchSchema,
  toFieldErrors,
} from "@/lib/schemas/adminSchemas";

const supabase = createAstroSupabase(Astro);

const id = Astro.params.id as string;
if (!id) return Astro.redirect("/admin/matches");
let errorMessage = "";
let fieldErrors: Record<string, string> = {};

// 1. Obtener datos para llenar el formulario
// A. El partido actual
const { data: match } = await supabase
  .from("matches")
  .select(
    "id, date, field_id, result, video_url, match_players(player_id, team)",
  )
  .eq("id", id)
  .single();

// Si no existe el partido, volvemos a la lista (o da error si no manejas el 404 manual)
if (!match) return Astro.redirect("/admin/matches");

// B. Listas para los selectores (Canchas y Jugadores)
const { data: fields } = await supabase
  .from("fields")
  .select("id, name")
  .order("name");
const { data: players } = await supabase
  .from("players")
  .select("id, nickname, is_guest")
  .eq("is_active", true) // <--- Agrega esto
  .order("is_guest", { ascending: true })
  .order("nickname", { ascending: true });

// C. Calcular quién jugaba dónde para marcar los checkboxes
const lightIds = match.match_players
  .filter((mp: any) => mp.team === "light")
  .map((mp: any) => String(mp.player_id));
const darkIds = match.match_players
  .filter((mp: any) => mp.team === "dark")
  .map((mp: any) => String(mp.player_id));

// --- LÓGICA DE GUARDADO (POST) ---
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const parsed = matchSchema.safeParse(formDataToMatchInput(formData));
    if (!parsed.success) {
      fieldErrors = toFieldErrors(parsed.error);
      throw new Error("Revisa los campos marcados en rojo.");
    }
    const { date, field_id, result, video_url, light_players, dark_players } = parsed.data;

    if (!field_id) {
      fieldErrors = { ...fieldErrors, field_id: "Sede obligatoria." };
      throw new Error("Faltan datos obligatorios para actualizar el partido.");
    }
    const selectedField = fields?.find(
      (field) => String(field.id) === field_id,
    );
    if (!selectedField) {
      fieldErrors = { ...fieldErrors, field_id: "La sede seleccionada no es válida." };
      throw new Error("La sede seleccionada no es válida.");
    }

    // 2. Resolver IDs jugadores contra lista conocida (evita IDs forjados)
    const playerIdByKey = new Map<string, string | number>();
    players?.forEach((player) => {
      playerIdByKey.set(String(player.id), player.id);
    });

    const resolvePlayerId = (key: string) => {
      const value = playerIdByKey.get(key);
      if (value === undefined) {
        throw new Error("No se pudo resolver un jugador seleccionado.");
      }
      return value;
    };

    const newPlayers = [
      ...light_players.map((key) => ({
        match_id: id,
        player_id: resolvePlayerId(key) as string,
        team: "light",
      })),
      ...dark_players.map((key) => ({
        match_id: id,
        player_id: resolvePlayerId(key) as string,
        team: "dark",
      })),
    ];

    // 3. Actualizar tabla MATCHES
    const { error: matchUpdateError } = await supabase
      .from("matches")
      .update({
        date,
        field_id: selectedField.id,
        result,
        video_url: video_url || null,
      })
      .eq("id", id);

    if (matchUpdateError) {
      throw new Error(
        "No se pudo actualizar la información general del partido.",
      );
    }

    // 4. Actualizar equipos (con rollback de mejor esfuerzo)
    const originalAssignments =
      match.match_players?.map((mp: any) => ({
        match_id: id,
        player_id: mp.player_id,
        team: mp.team,
      })) ?? [];

    const { error: deleteError } = await supabase
      .from("match_players")
      .delete()
      .eq("match_id", id);

    if (deleteError) {
      throw new Error(
        "No se pudieron limpiar los equipos anteriores del partido.",
      );
    }

    const { error: insertError } = await supabase
      .from("match_players")
      .insert(newPlayers);

    if (insertError) {
      // rollback: limpiar cualquier inserción parcial e intentar restaurar estado previo
      const { error: cleanupError } = await supabase
        .from("match_players")
        .delete()
        .eq("match_id", id);

      let rollbackError = null;
      if (originalAssignments.length > 0) {
        const { error } = await supabase
          .from("match_players")
          .insert(originalAssignments);
        rollbackError = error;
      }

      if (cleanupError || rollbackError) {
        throw new Error(
          "No se pudieron guardar los equipos y tampoco se pudo restaurar el estado anterior.",
        );
      }

      throw new Error(
        "No se pudieron guardar los equipos del partido. Se restauró el estado anterior.",
      );
    }

    return Astro.redirect(`/admin/matches/edit/${id}?toast=success&msg=Partido+actualizado+correctamente`);
  } catch (error: any) {
    errorMessage =
      error?.message ||
      "No se pudo actualizar el partido. Por favor, intenta más tarde.";
  }
}
---

<Main
  title="Editar Partido | SGSC"
  contentWidth="admin"
  toastType={errorMessage ? "error" : undefined}
  toastMessage={errorMessage || undefined}
>
  <Title title="Editar Partido" subtitle="Panel de Administración" />

  <form method="POST" class="max-w-full space-y-4 overflow-hidden sm:space-y-6">
    {/* Sección: Información General */}
    <div
      class="bg-base-100 border-base-200 max-w-full space-y-4 overflow-hidden rounded-xl border p-3.5 shadow-md sm:space-y-6 sm:p-6"
    >
      <div class="grid max-w-full grid-cols-1 gap-2.5 overflow-hidden sm:grid-cols-2 sm:gap-4 lg:gap-6">
        {/* Fecha */}
        <div class="form-control min-w-0">
          <fieldset class="fieldset">
            <legend class="fieldset-legend text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-1">Fecha del Partido</legend>
            <input
              type="date"
              name="date"
              class={fieldErrors.date ? "input input-sm sm:input-md min-h-[44px] w-full max-w-full rounded-xl px-3 input-error" : "input input-sm sm:input-md min-h-[44px] w-full max-w-full rounded-xl px-3"}
              required
              value={match.date}
              aria-invalid={fieldErrors.date ? "true" : undefined}
            />
            {fieldErrors.date && <p class="text-error mt-1 text-xs">{fieldErrors.date}</p>}
          </fieldset>
        </div>

        {/* Sede */}
        <div class="form-control min-w-0">
          <fieldset class="fieldset">
            <legend class="fieldset-legend text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-1">Sede</legend>
            <select
              name="field_id"
              required
              class={fieldErrors.field_id ? "select select-sm sm:select-md min-h-[44px] w-full max-w-full rounded-xl px-3 select-error" : "select select-sm sm:select-md min-h-[44px] w-full max-w-full rounded-xl px-3"}
            >
              {
                fields?.map((f) => (
                  <option value={f.id} selected={f.id === match.field_id}>
                    {f.name}
                  </option>
                ))
              }
            </select>
            {fieldErrors.field_id && <p class="text-error mt-1 text-xs">{fieldErrors.field_id}</p>}
          </fieldset>
        </div>

        {/* Resultado */}
        <div class="form-control min-w-0">
          <fieldset class="fieldset">
            <legend class="fieldset-legend text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-1">Resultado Final </legend>
            <select
              name="result"
              required
              class={fieldErrors.result ? "select select-sm sm:select-md min-h-[44px] w-full max-w-full rounded-xl px-3 font-bold select-error" : "select select-sm sm:select-md min-h-[44px] w-full max-w-full rounded-xl px-3 font-bold"}
            >
              <option value="light" selected={match.result === "light"}>
                Claro
              </option>
              <option value="dark" selected={match.result === "dark"}>
                Oscuro
              </option>
              <option value="draw" selected={match.result === "draw"}>
                Empate
              </option>
            </select>
            {fieldErrors.result && <p class="text-error mt-1 text-xs">{fieldErrors.result}</p>}
          </fieldset>
        </div>

        {/* Video URL */}
        <div class="form-control min-w-0">
          <fieldset class="fieldset">
            <legend class="fieldset-legend text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-1">
              Enlace de Video
              <span class="badge badge-ghost badge-xs ml-1 opacity-60">Opcional</span>
            </legend>
            <div class="flex w-full max-w-full gap-2">
              <input
                type="url"
                name="video_url"
                class={fieldErrors.video_url ? "input input-sm sm:input-md min-h-[44px] w-full min-w-0 flex-1 rounded-xl px-3 input-error" : "input input-sm sm:input-md min-h-[44px] w-full min-w-0 flex-1 rounded-xl px-3"}
                placeholder="https://..."
                value={match.video_url ?? undefined}
              />
              <button
                type="button"
                class="btn btn-sm sm:btn-md min-h-[44px] min-w-[44px] shrink-0 rounded-xl px-3"
                data-clear-field="video_url"
                title="Limpiar (guardar como null)"
                aria-label="Limpiar enlace video"
              >
                ✕
              </button>
            </div>
            {fieldErrors.video_url && <p class="text-error mt-1 text-xs">{fieldErrors.video_url}</p>}
          </fieldset>
        </div>
      </div>
    </div>

    {/* Divider */}
    <div
      class="divider text-base-content/60 text-xs font-bold tracking-wider uppercase"
    >
      Convocatoria
    </div>
    {(fieldErrors.light_players || fieldErrors.dark_players) && (
      <p class="text-error text-xs" role="alert">
        {fieldErrors.light_players || fieldErrors.dark_players}
      </p>
    )}

    {/* Sección: Equipos */}
    <div
      class="bg-base-100 border-base-200 max-h-96 w-full max-w-full overflow-auto overflow-x-hidden rounded-xl border shadow-md"
    >
      {/* Header */}
      <div
        class="bg-base-200 sticky top-0 z-10 grid grid-cols-[1fr_2.5rem_2.5rem_2.5rem] items-center gap-1 px-3 py-2 sm:grid-cols-[1fr_3rem_3rem_3rem] sm:gap-2"
      >
        <span class="text-xs font-bold sm:text-sm">Jugador</span>
        <span class="text-base-content/60 text-center text-xs">—</span>
        <span class="flex justify-center">
          <Icon
            name="material-symbols:wb-sunny"
            class="text-base text-slate-500 sm:text-xl dark:text-slate-300"
          />
        </span>
        <span class="flex justify-center">
          <Icon
            name="material-symbols:dark-mode"
            class="text-base text-slate-500 sm:text-xl dark:text-slate-300"
          />
        </span>
      </div>

      {/* Filas de jugadores */}
      <div class="divide-base-200 divide-y">
        {
          players?.map((p) => {
            const playerId = String(p.id);
            const isLight = lightIds.includes(playerId);
            const isDark = darkIds.includes(playerId);
            const isNone = !isLight && !isDark;

            return (
              <div class="hover:bg-base-200/50 grid grid-cols-[1fr_2.5rem_2.5rem_2.5rem] items-center gap-1 px-3 py-2 transition-colors sm:grid-cols-[1fr_3rem_3rem_3rem] sm:gap-2">
                {/* Nombre */}
                <div class="flex min-w-0 items-center gap-1">
                  <span
                    class="tooltip tooltip-right truncate text-xs font-bold sm:text-sm"
                    data-tip={p.nickname}
                  >
                    {p.nickname}
                  </span>
                  {p.is_guest && (
                    <span class="badge badge-ghost badge-xs border-base-300 shrink-0 opacity-60">
                      INV
                    </span>
                  )}
                </div>

                {/* No juega */}
                <div class="flex justify-center">
                  <input
                    type="radio"
                    name={`player_${p.id}`}
                    value="none"
                    class="radio radio-xs sm:radio-sm radio-error"
                    checked={isNone}
                  />
                </div>

                {/* Claro */}
                <div class="flex justify-center rounded">
                  <input
                    type="radio"
                    name={`player_${p.id}`}
                    value="light"
                    class="radio radio-xs sm:radio-sm radio-warning"
                    checked={isLight}
                  />
                </div>

                {/* Oscuro */}
                <div class="flex justify-center rounded">
                  <input
                    type="radio"
                    name={`player_${p.id}`}
                    value="dark"
                    class="player-selector radio radio-xs sm:radio-sm radio-neutral dark:radio-primary"
                    checked={isDark}
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    {/* Botones de acción */}
    <div
      class="flex max-w-full flex-col-reverse gap-2 overflow-hidden sm:flex-row sm:items-center sm:justify-between"
    >
      <a
        href="/admin/matches"
        class="btn btn-outline btn-error btn-sm sm:btn-md order-2 min-h-[44px] w-full rounded-xl sm:order-1 sm:w-auto"
      >
        <Icon name="material-symbols:arrow-back" size={18} />
        Cancelar
      </a>
      <button type="submit" class="btn btn-primary btn-sm sm:btn-md order-1 min-h-[44px] w-full grow rounded-xl sm:w-auto">
        <Icon name="material-symbols:save" size={20} />
        Guardar Cambios
      </button>
    </div>
  </form>
</Main>

<script>
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-clear-field]");
    if (!btn) return;
    const field = btn.getAttribute("data-clear-field");
    if (!field) return;
    const form = btn.closest("form");
    const input = form?.querySelector(`[name="${field}"]`) as HTMLInputElement | null;
    if (input) {
      input.value = "";
      input.focus();
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
  });
</script>

