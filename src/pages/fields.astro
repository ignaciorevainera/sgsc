---
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');

import { Icon } from "astro-icon/components";
import { supabase } from "../lib/supabase";
import { getFilters, clearFilters } from "@/lib/ux/filters";
import type { FieldFilters } from "@/lib/ux/types";
import Alert from "@/components/shared/Alert.astro";
import FieldCard from "@/components/FieldCard.astro";
import EmptyState from "@/components/features/ux/EmptyState.astro";
import ErrorRetry from "@/components/features/ux/ErrorRetry.astro";
import FilterBar from "@/components/features/ux/FilterBar.astro";
import Main from "@/layouts/Main.astro";
import Title from "@/components/shared/Title.astro";

const filters = getFilters<FieldFilters>(Astro.url, {
  defaults: { city: "", sort: "matches" },
});

const { data: rawFields, error } = await supabase.from("fields").select(`
    id,
    name,
    city,
    matches (
      id,
      result,
      date
    )
  `);

const allFields =
  rawFields
    ?.map((field) => {
      const matches = field.matches || [];
      const totalMatches = matches.length;
      const lightWins = matches.filter((m) => m.result === "light").length;
      const darkWins = matches.filter((m) => m.result === "dark").length;
      const draws = matches.filter((m) => m.result === "draw").length;
      const sortedMatches = matches.sort(
        (a, b) => (b.date || "").localeCompare(a.date || "")
      );
      const lastMatchDate =
        sortedMatches.length > 0 ? sortedMatches[0].date : null;
      return {
        ...field,
        stats: { totalMatches, lightWins, darkWins, draws, lastMatchDate },
      };
    }) || [];

let filtered = allFields;
if (filters.city) {
  filtered = filtered.filter((f) =>
    (f.city || "").toLowerCase() === filters.city.toLowerCase()
  );
}

if (filters.sort === "name") {
  filtered = [...filtered].sort((a, b) => a.name.localeCompare(b.name));
} else {
  filtered = [...filtered].sort(
    (a, b) => b.stats.totalMatches - a.stats.totalMatches
  );
}

const uniqueCities = [...new Set(allFields.map((f) => f.city || "").filter(Boolean))].sort();

const totalUniqueFields = filtered.length;
const totalMatchesGlobal = filtered.reduce(
  (acc, curr) => acc + curr.stats.totalMatches, 0
);

const hasError = !!error;
const hasFields = !hasError && filtered.length > 0;

const hasActiveFilters = filters.city !== "" || filters.sort !== "matches";
const clearedUrl = clearFilters(Astro.url, ["city", "sort"]);
const clearUrl = clearedUrl.pathname + clearedUrl.search;
---

<Main title="Sedes | SGSC">
  <Title
    title="Sedes"
    subtitle="Explora las sedes donde se juegan los partidos y sus estadísticas."
  />

  <FilterBar hasActiveFilters={hasActiveFilters} clearUrl={clearUrl}>
    <div class="form-control">
      <label for="city" class="label py-1">
        <span class="label-text text-base-content/60 text-xs font-bold uppercase">Ciudad</span>
      </label>
      <select
        id="city"
        name="city"
        class="select select-sm md:select-md w-full rounded-xl"
        aria-label="Filtrar por ciudad"
      >
        <option value="" selected={!filters.city}>Todas</option>
        {uniqueCities.map((c) => (
          <option value={c} selected={filters.city === c}>{c}</option>
        ))}
      </select>
    </div>

    <div class="form-control">
      <label for="sort-fields" class="label py-1">
        <span class="label-text text-base-content/60 text-xs font-bold uppercase">Ordenar por</span>
      </label>
      <select
        id="sort-fields"
        name="sort"
        class="select select-sm md:select-md w-full rounded-xl"
        aria-label="Ordenar sedes"
      >
        <option value="matches" selected={filters.sort === "matches"}>Más partidos</option>
        <option value="name" selected={filters.sort === "name"}>Nombre</option>
      </select>
    </div>
  </FilterBar>

  {
    hasError && (
      <ErrorRetry message="No se pudo cargar la información de las sedes. Por favor, intenta más tarde." />
    )
  }

  {
    !hasError && !hasFields && filters.city && (
      <EmptyState
        icon="material-symbols:location-off"
        title="Sin sedes"
        description={`No hay sedes registradas en "${filters.city}". Probá seleccionar otra ciudad.`}
      />
    )
  }

  {
    !hasError && !hasFields && !filters.city && (
      <Alert type="info" message="No hay sedes registradas en el sistema." />
    )
  }

  {
    hasFields && (
      <>
        <div class="stats stats-vertical sm:stats-horizontal bg-base-100 border-base-200 mb-8 w-full rounded-xl border shadow-md">
          <div class="stat place-items-center md:place-items-start">
            <div class="stat-figure text-primary hidden md:block">
              <Icon name="material-symbols:stadium-outline" size={42} />
            </div>
            <div class="stat-title">Sedes Visitadas</div>
            <div class="stat-value text-primary">{totalUniqueFields}</div>
            <div class="stat-desc">Canchas distintas</div>
          </div>
          <div class="stat place-items-center md:place-items-start">
            <div class="stat-figure text-secondary hidden md:block">
              <Icon name="material-symbols:sports-soccer" size={42} />
            </div>
            <div class="stat-title">Partidos Totales</div>
            <div class="stat-value text-secondary">{totalMatchesGlobal}</div>
            <div class="stat-desc">En todas las sedes</div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {filtered.map((field) => (
            <FieldCard field={field} />
          ))}
        </div>
      </>
    )
  }
</Main>

<script>
  const city = document.getElementById("city") as HTMLSelectElement | null;
  const sort = document.getElementById("sort-fields") as HTMLSelectElement | null;

  const update = () => {
    const url = new URL(window.location.href);
    if (city && city.value) url.searchParams.set("city", city.value);
    else url.searchParams.delete("city");
    if (sort && sort.value && sort.value !== "matches") url.searchParams.set("sort", sort.value);
    else url.searchParams.delete("sort");
    window.location.href = url.toString();
  };

  city?.addEventListener("change", update);
  sort?.addEventListener("change", update);
</script>
